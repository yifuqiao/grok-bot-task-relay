# Copy this file to .env and fill it from the Grok Bot Routines panel.
# Put the webhook key only in this local file. Never paste it into chat, git, or screenshots.

GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=
GROK_BOT_WEBHOOK_AUTH_HEADER=authorization
GROK_BOT_WEBHOOK_AUTH_SCHEME=Bearer

# webhook (default) or pull (executor inbox, no receiver webhook required).
# pull requires RELAY_DATA_DIR and BOT_REPORT_KEY plus an authenticated executor worker.
RELAY_DELIVERY_MODE=webhook

# Callers send this as Authorization: Bearer. It is separate from the webhook key.
RELAY_API_KEY=

PORT=8787
HOST=127.0.0.1
RELAY_ALLOWED_ORIGINS=

# Opt in to persistent tasks; relative paths resolve from the project directory.
RELAY_DATA_DIR=
RELAY_PUBLIC_BASE_URL=
# Executor-only key: Grok Bot fetches manifests and reports actual completion.
BOT_REPORT_KEY=
# JSON maps, stored only in your private environment file. Never commit real values.
RELAY_CLIENT_KEYS={}
RELAY_CALLBACK_TARGETS={}
