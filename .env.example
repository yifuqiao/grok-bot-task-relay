# Copy this file to .env and fill it from the Grok Bot Routines panel.
# Put the webhook key only in this local file. Never paste it into chat, git, or screenshots.

GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=
GROK_BOT_WEBHOOK_AUTH_HEADER=authorization
GROK_BOT_WEBHOOK_AUTH_SCHEME=Bearer

# Callers send this as Authorization: Bearer. It is separate from the webhook key.
RELAY_API_KEY=

PORT=8787
HOST=127.0.0.1
RELAY_ALLOWED_ORIGINS=
