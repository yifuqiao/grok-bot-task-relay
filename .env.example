# Copy this file to .env and fill it from the Grok Bot Routines panel.
# Put the webhook key only in this local file. Never paste it into chat, git, or screenshots.

GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=
GROK_BOT_WEBHOOK_AUTH_HEADER=authorization
GROK_BOT_WEBHOOK_AUTH_SCHEME=Bearer

# webhook (default) or pull (executor inbox).
# pull requires RELAY_DATA_DIR and BOT_REPORT_KEY plus an authenticated executor worker.
# If pull mode also has GROK_BOT_WEBHOOK_URL and GROK_BOT_WEBHOOK_KEY, the relay
# notifies Grok Bot once with relay_task_id so ChatGPT can read later progress.
RELAY_DELIVERY_MODE=webhook

# Callers send this as Authorization: Bearer. It is separate from the webhook key.
RELAY_API_KEY=

PORT=8787
HOST=127.0.0.1
RELAY_ALLOWED_ORIGINS=

# Opt in to persistent tasks; relative paths resolve from the project directory.
RELAY_DATA_DIR=
# Public origin for OAuth discovery. No path and no trailing slash.
# Required when NODE_ENV=production. The relay does not trust X-Forwarded-Host.
# Example: https://relay.onetopway.com
RELAY_PUBLIC_BASE_URL=
# Executor-only key: Grok Bot fetches manifests and posts execution status.
# ChatGPT reads that status with getTaskStatus. Never paste this key into chat.
BOT_REPORT_KEY=
# Status files for webhook handoffs. Leave unset to use data/grok-status. Set empty to disable.
GROK_STATUS_DIR=
# JSON maps, stored only in your private environment file. Never commit real values.
RELAY_CLIENT_KEYS={}
RELAY_CALLBACK_TARGETS={}

# ChatGPT can hand a task to a Cursor cloud agent. Leave both empty until that is enabled.
# CURSOR_API_KEY comes from Cursor Dashboard → Integrations. Never paste it into chat.
CURSOR_API_KEY=
# Token used only to create a private GitHub repository for a new task.
CURSOR_GITHUB_TOKEN=

# Deploys through Grok Bot. Requires RELAY_DATA_DIR and BOT_REPORT_KEY.
# Each target is a name the model may pick; repo, environment and health check come from here,
# never from the chat. health_url must be HTTPS and return JSON with the running commit at
# health_sha_field (dot path, default "commit"). requires_approval holds the deploy in the relay
# until a human approves at /approvals/<id> with RELAY_APPROVAL_KEY.
# owners lists the caller identities allowed to use the target ("default" = RELAY_API_KEY and OAuth).
# Example:
# RELAY_DEPLOY_TARGETS={"relay-prod":{"owners":["default","claude"],"repo":"yifuqiao/grok-bot-task-relay","environment":"production","health_url":"https://relay.onetopway.com/health","health_sha_field":"commit","requires_approval":true}}
RELAY_DEPLOY_TARGETS={}
# Human-only key for the approval page (24+ characters). Required when any target sets requires_approval.
# It must differ from every caller and executor key. Keep it off every chat platform and agent.
RELAY_APPROVAL_KEY=

# GitHub receipts: commit statuses and PR comments for tasks that name a PR or commit.
# Fine-grained token with Commit statuses: write and Pull requests (or Issues): write on the repos below.
RELAY_GITHUB_TOKEN=
# Extra repos (owner/name, comma separated) that ordinary tasks may receipt to. Deploy target repos are always allowed.
RELAY_GITHUB_REPOS=

# The relay reports its own commit on /health. Set it here, or write the sha to a REVISION file at deploy time.
RELAY_GIT_SHA=
